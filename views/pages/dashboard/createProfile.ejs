<%- include("../../partials/head.ejs") %>

<main class="bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4 p-md-5">
                        
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark">Create Your Profile</h2>
                            <p class="text-muted">Fill in your personal and professional details below</p>
                        </div>

                                                    <!-- Profile Picture Upload & Preview -->
                            <div class="text-center mb-4">
                                <div class="position-relative d-inline-block">
                                    <img id="imagePreview" 
                                         src="<%= user.profileImage ? user.profileImage : '/uploads/default.png' %>" 
                                         alt="Profile Preview" 
                                         class="rounded-circle border border-3 border-primary shadow-sm object-fit-cover" 
                                         style="width: 130px; height: 130px;">
                                </div>
                                <div class="mt-3">
                                    <label for="profilePic" class="form-label fw-semibold text-secondary">Choose Profile Image</label>
                                    <input type="file" class="form-control form-control-sm mx-auto" id="profilePic" name="profilePic" accept="image/*" style="max-width: 320px;" onchange="previewFile(event)">
                                </div>
                            </div>
                            
                        <!-- enctype="multipart/form-data" is required for file uploads -->
                        <form action="/dashboard/create-profile" method="POST" enctype="multipart/form-data">
                            
                            <!-- Name and Email -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="name" name="name" placeholder="e.g. John Doe" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" id="email" name="email" placeholder="example@mail.com" required>
                                </div>
                            </div>

                            <!-- Professional Title -->
                            <div class="mb-3">
                                <label for="title" class="form-label fw-semibold">Professional Title</label>
                                <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Full-Stack Web Developer / UI Designer">
                            </div>

                            <!-- Short Bio -->
                            <div class="mb-4">
                                <label for="bio" class="form-label fw-semibold">Short Bio</label>
                                <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Tell us a little bit about yourself..."></textarea>
                            </div>

                            <hr class="my-4 text-muted">

                            <!-- Social Links -->
                            <h5 class="fw-bold mb-3 text-secondary">Social Profiles</h5>
                            
                            <div class="mb-3">
                                <label for="facebook" class="form-label fw-semibold">Facebook Profile</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-facebook text-primary"></i></span>
                                    <input type="url" class="form-control" id="facebook" name="facebook" placeholder="https://facebook.com/yourusername">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="whatsapp" class="form-label fw-semibold">WhatsApp</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-whatsapp text-success"></i></span>
                                    <input type="text" class="form-control" id="whatsapp" name="whatsapp" placeholder="+8801XXXXXXXXX or https://wa.me/...">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="instagram" class="form-label fw-semibold">Instagram Profile</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-instagram text-danger"></i></span>
                                    <input type="url" class="form-control" id="instagram" name="instagram" placeholder="https://instagram.com/yourusername">
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary btn-lg shadow-sm">Save Profile</button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Live Image Preview Script -->
<script>
    function previewFile(event) {
        const input = event.target;
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<%- include("../../partials/footer.ejs") %>

</body>
</html>